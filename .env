export REPO_DIR="$(dirname "${BASH_SOURCE[0]}")"
export ENV_FILE="${REPO_DIR}/.env"
export ENV_DIR="${REPO_DIR}/.envs"
export TEMP_DIR="/tmp"
export TEMPLATES_DIR="${REPO_DIR}/templates"
export BACKUP_DIR="${REPO_DIR}/.backups"

source ${ENV_DIR}/utils.env
source ${ENV_DIR}/console.env
source ${ENV_DIR}/timezone.env
source ${ENV_DIR}/locale.env
source ${ENV_DIR}/timesyncd.env
source ${ENV_DIR}/hostname.env
source ${ENV_DIR}/initramfs.env
source ${ENV_DIR}/users.env
source ${ENV_DIR}/packages.env
source ${ENV_DIR}/grub.env
source ${ENV_DIR}/ssh.env

export HOSTNAME="arch"
export CONSOLE_FONT="ter-132b"
export TIMEZONE="Europe/Moscow"
export DEFAULT_LOCALE="en_US.UTF-8"
export ADDITIONAL_LOCALES=( "ru_RU.UTF-8" )
export USER_NAME="jetron"
export USER_SHELL="/usr/bin/zsh"
export USER_GROUPS=(
    wheel
    video
)
export NTP_SERVERS=(
    0.arch.pool.ntp.org
    1.arch.pool.ntp.org
    2.arch.pool.ntp.org
    3.arch.pool.ntp.org
)
export FALLBACK_NTP_SERVERS=(
    0.pool.ntp.org
    1.pool.ntp.org
    2.pool.ntp.org
    3.pool.ntp.org
)
export INITRAMFS_HOOKS=(
    systemd
    autodetect
    microcode
    modconf
    kms
    keyboard
    keymap
    consolefont
    block
    filesystems
    fsck
)
export INITRAMFS_MODULES=(
    btrfs
)

export GRUB_SET_THEME=1
export GRUB_THEMES_REPO="https://github.com/13atm01/GRUB-Theme.git"
export GRUB_THEME_NAME="Airani Iofifteen"

export SSH_SERVER_PORT=2202
export SSH_SERVER_LISTEN_ADDRESS="0.0.0.0"
export PERMIT_ROOT_LOGIN="no"
export PASSWORD_AUTHENTICATION="no"

source .packages

print_colored() {
    RED_COLOR="\033[31m"
    GREEN_COLOR="\033[32m"
    YELLOW_COLOR="\033[33m"
    MAGENTA_COLOR="\033[35m"
    RESET="\033[0m"

    color=$1
    shift
    if [[ $color == "red" ]]; then
        printf "${RED_COLOR}%s${RESET}\n" "$@"
    elif [[ $color = "green" ]]; then
        printf "${GREEN_COLOR}%s${RESET}\n" "$@"
    elif [[ $color = "yellow" ]]; then
        printf "${YELLOW_COLOR}%s${RESET}\n" "$@"
    elif [[ $color = "magenta" ]]; then
        printf "${MAGENTA_COLOR}%s${RESET}\n" "$@"
    else
        echo "$@"
    fi
}

log() {
    if [[ $dry_run == "1" ]]; then
        print_colored magenta "[DRY_RUN]: $*"
    else
        print_colored green "$@"
    fi
}

execute() {
    log "execute $*"
    if [[ $dry_run == "1" ]]; then
        return
    fi

    "$@"
}

backup() {
    FILE_PATH=$1
    FILE_NAME=$(basename $FILE_PATH)
    POSTFIX="backup_$(date +%F_%R)"
    if [ ! -f $FILE_PATH ]; then
        print_colored yellow "[WARNING]: backup failed! File $FILE_PATH doesn't exists!"
        return
    fi
    cp $FILE_PATH $BACKUP_DIR/${FILE_NAME}.${POSTFIX}
}

arr_join() {
    local delimiter="$1"
    shift
    local str="$1"
    shift
    
    for arg; do
        str="${str}${delimiter}${arg}"
    done

    echo "${str}"
}

SUDO="sudo"
if (( $UID == 0 )); then
    SUDO=""
fi

export SUDO
export -f print_colored
export -f backup
export -f arr_join

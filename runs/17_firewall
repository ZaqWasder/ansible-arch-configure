#!/usr/bin/env bash
set -eu

IPTABLES_CONF_DIR="/etc/iptables"
IPTABLES_CONF_FILE="iptables.rules"
IP6TABLES_CONF_FILE="ip6tables.rules"

backup ${IPTABLES_CONF_DIR}/${IPTABLES_CONF_FILE}
backup ${IPTABLES_CONF_DIR}/${IP6TABLES_CONF_FILE}

$SUDO rm -r ${IPTABLES_CONF_DIR}
$SUDO mkdir -p ${IPTABLES_CONF_DIR}

envsubst < ${TEMPLATES_DIR}/${IPTABLES_CONF_FILE}.tmpl > ${TEMP_DIR}/${IPTABLES_CONF_FILE}
envsubst < ${TEMPLATES_DIR}/${IP6TABLES_CONF_FILE}.tmpl > ${TEMP_DIR}/${IP6TABLES_CONF_FILE}

$SUDO mv /tmp/${IPTABLES_CONF_FILE} ${IPTABLES_CONF_DIR}/${IPTABLES_CONF_FILE}
$SUDO mv /tmp/${IP6TABLES_CONF_FILE} ${IPTABLES_CONF_DIR}/${IP6TABLES_CONF_FILE}

$SUDO systemctl restart iptables
$SUDO systemctl restart ip6tables
